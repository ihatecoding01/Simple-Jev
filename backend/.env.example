GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Thresholds
CACHE_SIMILARITY_THRESHOLD=0.74
EXACT_CACHE_THRESHOLD=0.88
MAX_RETRY_ATTEMPTS=3
DAILY_INQUIRY_LIMIT=25
PORT=8000
